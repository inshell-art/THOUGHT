{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inshell.art/schemas/thought.agent-result.v2.schema.json",
  "title": "THOUGHT Agent Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agentLine", "provenanceFragment"],
  "properties": {
    "schema": { "const": "thought.agent-result.v2" },
    "agentLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "description": "One concise visible UTF-8 Agent line. The authoritative contract validator also enforces 180 UTF-8 bytes, 162 deterministic display units, and one-line/control/spacing rules."
    },
    "provenanceFragment": {
      "$ref": "thought.agent-fragment.v1.schema.json"
    }
  }
}

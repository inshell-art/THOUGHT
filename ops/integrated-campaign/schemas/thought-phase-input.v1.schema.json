{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inshell.thought.deployment.phase.input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaignId", "bundleId", "phase", "environment", "chainId", "priorReceipt", "release", "authorities", "execution", "protocolRegistration", "selectedSpec", "pathMutationOwner", "pathMutationPerformed", "deploymentAuthorizationIncluded"],
  "properties": {
    "schema": { "const": "inshell.thought.deployment.phase.input.v1" },
    "campaignId": { "type": "string", "minLength": 1 },
    "bundleId": { "type": "string", "minLength": 1 },
    "phase": { "const": "thought" },
    "environment": { "enum": ["internal-sepolia", "public-beta-sepolia", "mainnet"] },
    "chainId": { "type": "integer", "minimum": 1 },
    "priorReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptType", "schemaId", "envelopeSha256", "payloadSha256", "pathNft", "pathBundleDigest"],
      "properties": {
        "receiptType": { "const": "inshell.path.phase-a.receipt.v1" },
        "schemaId": { "const": "inshell.path.deployment.phase-a.receipt.v1" },
        "envelopeSha256": { "$ref": "#/$defs/hash" },
        "payloadSha256": { "$ref": "#/$defs/hash" },
        "pathNft": { "$ref": "#/$defs/address" },
        "pathBundleDigest": { "$ref": "#/$defs/hash" }
      }
    },
    "release": { "type": "object", "required": ["artifactId", "manifestSha256", "publicationCommit", "sourceTag"] },
    "authorities": { "type": "object", "required": ["deployer", "registryOwner", "attestationAuthority", "pathRetainedAuthority"] },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rpcEnvironmentVariable", "deploySigner", "registryOwnerSigner", "confirmations", "retrySigningTransactionSilently"],
      "properties": {
        "rpcEnvironmentVariable": { "const": "THOUGHT_RPC_URL" },
        "deploySigner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signerRef", "kind", "keystoreEnvironmentVariable", "passwordFileEnvironmentVariable"],
          "properties": {
            "signerRef": { "type": "string", "minLength": 1 },
            "kind": { "const": "encrypted-keystore" },
            "keystoreEnvironmentVariable": { "const": "THOUGHT_DEPLOY_KEYSTORE" },
            "passwordFileEnvironmentVariable": { "const": "THOUGHT_DEPLOY_PASSWORD_FILE" }
          }
        },
        "registryOwnerSigner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signerRef", "kind", "derivationPathEnvironmentVariable"],
          "properties": {
            "signerRef": { "type": "string", "minLength": 1 },
            "kind": { "const": "ledger" },
            "derivationPathEnvironmentVariable": { "const": "THOUGHT_ADMIN_LEDGER_DERIVATION_PATH" }
          }
        },
        "confirmations": { "type": "integer", "minimum": 1 },
        "retrySigningTransactionSilently": { "const": false }
      }
    },
    "protocolRegistration": { "type": "object", "required": ["manifestHash", "manifestUri", "protocolReleaseId"] },
    "selectedSpec": { "type": "object", "required": ["name", "byteLength", "sha256", "thoughtSpecId", "thoughtSpecHash", "ref"] },
    "pathMutationOwner": { "const": "PATH_PHASE_B" },
    "pathMutationPerformed": { "const": false },
    "deploymentAuthorizationIncluded": { "const": false }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

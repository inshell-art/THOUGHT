{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inshell.art/protocol/releases/v2/agent/thought.agent-result.v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "agentLine": {
      "minLength": 1,
      "type": "string",
      "x-thought-line-profile": "inshell.thought.work.v2",
      "x-thought-utf8-max-bytes": 64
    },
    "declaration": { "$ref": "thought.agent-declaration.v1.schema.json" },
    "release": {
      "additionalProperties": false,
      "properties": {
        "manifestKeccak256": { "$ref": "#/$defs/bytes32" },
        "protocolReleaseId": { "$ref": "#/$defs/bytes32" }
      },
      "required": ["protocolReleaseId", "manifestKeccak256"],
      "type": "object"
    },
    "schema": { "const": "inshell.thought.agent-result.v2" }
  },
  "required": ["schema", "release", "agentLine"],
  "title": "THOUGHT Agent Result V2",
  "type": "object",
  "$defs": {
    "bytes32": { "pattern": "^0x[0-9a-f]{64}$", "type": "string" }
  }
}

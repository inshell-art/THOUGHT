      "agentBytes",
      "promptWeight",
      "agentWeight",
      "loomWeight",
      "bitDistance",
      "protocolReleaseId",
      "manifestKeccak256",
      "rendererId",
      "rendererProfileKeccak256",
      "workProfileId",
      "workProfileKeccak256",
      "provenanceKeccak256"

    "elementOrder": ["canvas-bg", "binary-background", "clip-definitions", "agent-line-area", "prompt-line-area"],
    "jsonEscaping": "contract-fixed-json-string-escaping",
    "numberFormatting": "unsigned-base10-no-leading-zero",

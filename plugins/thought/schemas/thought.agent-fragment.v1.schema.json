{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inshell.art/schemas/thought.agent-fragment.v1.schema.json",
  "title": "THOUGHT Agent Provenance Fragment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "declaredAgent",
    "declaredOneRound",
    "declaredNoWalletUse",
    "thoughtSpecId",
    "thoughtSpecHash"
  ],
  "properties": {
    "schema": { "const": "thought.agent-fragment.v1" },
    "declaredAgent": { "type": "string", "minLength": 1, "maxLength": 128 },
    "declaredOneRound": { "const": true },
    "declaredNoWalletUse": { "const": true },
    "thoughtSpecId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "thoughtSpecHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}

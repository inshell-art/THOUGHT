{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inshell.thought.glyph-library-set.v1",
  "title": "THOUGHT Glyph Library set manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "ordinal",
    "ordinalLabel",
    "slug",
    "version",
    "qualificationStatus",
    "declaredOn",
    "format",
    "canonicalOrder",
    "memberCount",
    "fontCount",
    "membershipPolicy",
    "schemas",
    "fonts"
  ],
  "properties": {
    "schema": { "const": "inshell.thought.glyph-library-set.v1" },
    "id": { "const": "inshell.thought.glyph-library.set-01" },
    "name": { "const": "THOUGHT Glyph Library — First Set" },
    "ordinal": { "const": 1 },
    "ordinalLabel": { "const": "1st Set" },
    "slug": { "const": "first-set" },
    "version": { "const": 1 },
    "qualificationStatus": { "const": "study-qualified" },
    "declaredOn": { "type": "string", "format": "date" },
    "format": { "const": "native-svg-path-json" },
    "canonicalOrder": { "type": "string", "minLength": 76, "maxLength": 76 },
    "memberCount": { "const": 24 },
    "fontCount": { "const": 24 },
    "membershipPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "string", "minLength": 1 },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontManifest", "metrics"],
      "properties": {
        "fontManifest": { "const": "schemas/glyph-manifest.schema.json" },
        "metrics": { "const": "schemas/glyph-metrics.schema.json" }
      }
    },
    "fonts": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "familyId",
          "legacyBlindId",
          "slug",
          "name",
          "file",
          "sha256",
          "fixture",
          "fixtureSha256",
          "glyphCount"
        ],
        "properties": {
          "memberId": { "type": "string", "minLength": 1 },
          "familyId": { "type": "string", "pattern": "^S[0-9]{2}$" },
          "legacyBlindId": { "type": "string", "pattern": "^B[0-9]{2}$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^fonts/[a-z0-9-]+/glyphs\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "fixture": { "type": "string", "pattern": "^fixtures/[a-z0-9-]+/canonical-line\\.svg$" },
          "fixtureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "glyphCount": { "const": 76 }
        }
      }
    }
  }
}

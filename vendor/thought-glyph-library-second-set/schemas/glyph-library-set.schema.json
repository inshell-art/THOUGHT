      },
      "required": [
        "fontManifest",
        "metrics"
      ],
      "type": "object"
    },
    "slug": {
      "const": "second-set"
    },
    "storageModel": {
      "const": "storage-model.json"
    },
    "types": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approachLabel": {
            "minLength": 1,
            "type": "string"
          },
          "approachNumber": {
            "enum": [
              2,
              3,
              4
            ]
          },
          "id": {
            "enum": [
              "segment-mask",
              "stroke-graph",
              "routed-path"
            ]
          },
          "memberCount": {
            "const": 12
          }
        },
        "required": [
          "id",
          "approachNumber",
          "approachLabel",
          "memberCount"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "ordinal",
    "ordinalLabel",
    "slug",
    "version",
    "qualificationStatus",
    "declaredOn",
    "format",
    "canonicalOrder",
    "memberCount",
    "fontCount",
    "membershipPolicy",
    "types",
    "schemas",
    "storageModel",
    "reviewSummary",
    "fonts"
  ],
  "title": "THOUGHT Glyph Library Second Set manifest",
  "type": "object"
}
